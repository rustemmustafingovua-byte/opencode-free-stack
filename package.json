{
  "name": "opencode-free-stack",
  "version": "0.1.0",
  "description": "Free-model stack for OpenCode: route requests to genuinely free models across providers, pace them to free-tier RPM limits, track daily quotas, and fall back automatically when one provider is empty.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ofs": "bin/ofs.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./plugin": "./plugin/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "free",
    "free-tier",
    "llm",
    "router",
    "fallback",
    "quota",
    "ai-agents",
    "plugin",
    "opencode-plugin"
  ],
  "files": [
    "bin",
    "src",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node --check src/index.js && node --check bin/ofs.js",
    "sync-models": "node scripts/sync-models.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rustemmustafingovua-byte/opencode-free-stack.git"
  },
  "bugs": {
    "url": "https://github.com/rustemmustafingovua-byte/opencode-free-stack/issues"
  },
  "homepage": "https://github.com/rustemmustafingovua-byte/opencode-free-stack#readme",
  "dependencies": {
    "viem": "^2.57.11"
  },
  "funding": {
    "custom": [
      "https://github.com/sponsors/rustemmustafingovua-byte"
    ]
  }
}
